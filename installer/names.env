#
# Every name the installer work uses, in one place (the release script work), so a rename
# (the Kettle Video rename, or a later one) changes them here once. The release script, and the
# installer, updater and uninstaller after it, read this file; none of them
# writes a name of its own.
#
# Plain KEY="value" lines: a shell can `source` it and Python reads it with
# backend/app_paths.py's read_names(). Since the rename (the Kettle Video rename) the ids are
# kettle-video.

# The name people read (desktop entry, installer messages).
APP_NAME="Kettle Video"
# The id used in folder and file names.
APP_ID="kettle-video"
# The release archive is ARCHIVE_NAME-<version>.tar.gz.
ARCHIVE_NAME="kettle-video"
# The name of the folder the app is installed into (where that folder goes
# in the home folder is the installer's choice, the installer work).
INSTALL_FOLDER="kettle-video"
# The installed copy's desktop entry file name (install.sh).
DESKTOP_ENTRY="kettle-video.desktop"
# A development copy's own desktop entry file name (install-shortcut.sh), so
# the two copies never share one entry (the installer review fixes).
DEV_DESKTOP_ENTRY="kettle-video-dev.desktop"
# The file the installer leaves in the installed app folder (the installer work). Its
# presence tells the app it is an installed copy, so it keeps settings, data
# and logs in the home folder's standard places (backend/app_paths.py). A
# development copy never has it.
INSTALL_MARK="kettle-video-installed"
# The app's icon, inside the app folder (the installer work; ui/ is where the app's own pictures live).
ICON_FILE="ui/kettle-video.png"
# The installed copy's kiosk window Firefox profile folder, which launch.sh
# makes in ~/.mozilla (system Firefox) or in Flatpak Firefox's data folder.
# The uninstaller removes it with the app files (the uninstaller work);
# backend/app_paths.py gives launch.sh this name for an installed copy, and
# launch.sh's fallback must say the same (tests/test_uninstaller.py checks it).
FIREFOX_PROFILE="kettle-video-profile"
# A development copy's own profile folder, beside it, so the two copies never
# share browser storage (the each-copy-its-own-data work). The installer and
# uninstaller never read or remove it.
DEV_FIREFOX_PROFILE="kettle-video-dev-profile"
